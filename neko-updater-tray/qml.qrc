        <file alias="0xProtoNerdFontMono-Regular.ttf">../neko-updater-core/Data/fonts/0xProtoNerdFontMono-Regular.ttf</file>
        <file alias="0xProtoNerdFontMono-Bold.ttf">../neko-updater-core/Data/fonts/0xProtoNerdFontMono-Bold.ttf</file>
        <file alias="0xProtoNerdFontMono-Italic.ttf">../neko-updater-core/Data/fonts/0xProtoNerdFontMono-Italic.ttf</file>
        <file alias="0xProtoNerdFontPropo-Regular.ttf">../neko-updater-core/Data/fonts/0xProtoNerdFontPropo-Regular.ttf</file>
        <file alias="0xProtoNerdFontPropo-Bold.ttf">../neko-updater-core/Data/fonts/0xProtoNerdFontPropo-Bold.ttf</file>
