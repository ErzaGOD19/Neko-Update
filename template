# Template file for 'neko-void-updater'
pkgname=Neko-Update
version=5.0.0
revision=1
hostmakedepends="cargo rust qt6-base qt6-tools-devel make pkg-config cmake"
makedepends="rust-std qt6-base-devel qt6-declarative-devel"
depends="polkit runit dbus"
short_desc="Neko Void Updater - Sistema de actualización para Void Linux"
maintainer="ANOMALI0x00 <ANOMALI0x00@users.noreply.github.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/ANOMALI0x00/Neko-Update"
distfiles="https://github.com/ANOMALI0x00/Neko-Update/archive/refs/tags/${version}.tar.gz"
checksum=90a41b649be4b40c415182e4226d18e9720ffea35bbf46d31a3e48e7f9a5cfa2

do_build() {
    # Construir core (Rust)
    cd neko-updater-core
    cargo build --release
    cd ..

    # Construir tray (Qt6)
    cd neko-updater-tray
    mkdir -p build
    cd build
    cmake ..
    make
    cd ../..
}

do_install() {
    # Binarios
    vbin neko-updater-core/target/release/neko-updater-core
    vbin neko-updater-tray/build/neko-updater-tray

    # Datos (iconos, recursos)
    vmkdir usr/share/neko-void
    cp -r neko-updater-core/Data/* "${DESTDIR}/usr/share/neko-void/"
    vinstall neko-updater-core/Data/logo.png 644 usr/share/pixmaps neko-updater.png

    # Traducciones (.qm)
    if [ -d neko-updater-tray/build/translations ]; then
        vmkdir usr/share/neko-void/translations
        vinstall neko-updater-tray/build/translations/neko_de.qm 644 usr/share/neko-void/translations
        vinstall neko-updater-tray/build/translations/neko_pt.qm 644 usr/share/neko-void/translations
        vinstall neko-updater-tray/build/translations/neko_it.qm 644 usr/share/neko-void/translations
        vinstall neko-updater-tray/build/translations/neko_ja.qm 644 usr/share/neko-void/translations
    fi

    # Política de Polkit
    vmkdir usr/share/polkit-1/actions
    vinstall "files/void.pkexec.xbps.policy" 644 usr/share/polkit-1/actions org.neko_void.updater.policy

    vinstall "files/neko-void-updater.desktop" 644 usr/share/applications
    vmkdir etc/xdg/autostart
    vinstall "files/neko-void-updater.desktop" 644 etc/xdg/autostart

    # Runit Service
    vmkdir etc/sv/neko-void-sync
    vinstall "files/neko-void-sync/run" 755 etc/sv/neko-void-sync run
}
